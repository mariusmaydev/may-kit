{
  "description": "Session locks (may-kit-sperren). Active only in a repo whose .claude/sperren starts with \"an\".",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__supabase__deploy_edge_function",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sperren.mjs\" pre", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__supabase__deploy_edge_function",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sperren.mjs\" post", "timeout": 10 }]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sperren.mjs\" datei", "timeout": 10 }]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell|mcp__supabase__deploy_edge_function",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sperren.mjs\" post", "timeout": 10 }]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sperren.mjs\" prompt", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sperren.mjs\" stop", "timeout": 10 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sperren.mjs\" ende", "timeout": 10 }] }
    ]
  }
}
